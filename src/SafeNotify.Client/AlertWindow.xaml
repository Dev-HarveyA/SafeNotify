<Window x:Class="SafeNotify.Client.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafeNotify Alert" Width="620" Height="420" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowActivated="True" ShowInTaskbar="False" Background="#F2F0E9"
        Closing="Window_Closing">
    <Border x:Name="Shell" Margin="12" CornerRadius="3" BorderThickness="1" BorderBrush="#D6D7CE" Background="#FFFEFA">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="AlertStripe" Grid.Row="0" Background="#087579" />
            <StackPanel Grid.Row="1" Margin="34,30,34,8">
                <TextBlock x:Name="SeverityText" Text="MESSAGE" Foreground="#075D61" FontSize="14" FontWeight="Bold" />
                <TextBlock x:Name="TitleText" Text="Alert title" Foreground="#202C2C" FontFamily="Georgia" FontSize="34" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
            <ScrollViewer Grid.Row="2" Margin="34,10,34,24" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText" Text="Alert message" Foreground="#354541" FontSize="21" TextWrapping="Wrap" LineHeight="30" />
            </ScrollViewer>
            <StackPanel Grid.Row="3" Margin="34,0,34,30">
                <Button x:Name="AcknowledgeButton" Content="Acknowledge alert" Height="58" Background="#087579" Foreground="White" BorderThickness="0" FontSize="18" FontWeight="Bold" Click="Acknowledge_Click" />
                <TextBlock x:Name="InstructionText" Text="Acknowledge to close this alert." Foreground="#586965" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
