<Window x:Class="SafeNotify.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafeNotify" Height="720" Width="1080" MinHeight="620" MinWidth="850"
        WindowStartupLocation="CenterScreen" Background="#F2F0E9"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" Drop="Window_Drop">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#183236" Padding="24,25,24,20">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <Border Width="42" Height="42" CornerRadius="3" Background="#E3A252">
                            <TextBlock Text="S" Foreground="#193236" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SafeNotify" FontSize="21" FontWeight="Bold" Foreground="#FFFEFA" />
                            <TextBlock Text="WINDOWS CLIENT" FontSize="10" Foreground="#C4D2CC" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Connection" Foreground="#E7ECE7" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,9" />
                    <Border Background="#29464A" BorderBrush="#456064" BorderThickness="1" Padding="11" Margin="0,0,0,22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="9" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="ConnectionDot" Grid.Column="0" Width="9" Height="9" Fill="#DCA24E" Margin="0,5,0,0" />
                            <TextBlock x:Name="ConnectionStatus" Grid.Column="1" Text="Not connected" Foreground="#FFFEFA" FontSize="12" TextWrapping="Wrap" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    <TextBlock Text="Server address" Foreground="#E7ECE7" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBox x:Name="ServerAddress" Height="42" Padding="10,9" Background="#FFFEFA" Foreground="#202C2C" BorderBrush="#AAB5AD" CaretBrush="#202C2C" Text="http://127.0.0.1:5080" />
                    <Button x:Name="DiscoverButton" Content="Find organisation" Height="42" Margin="0,10,0,0" Background="#E3A252" Foreground="#193236" BorderThickness="0" FontWeight="Bold" Click="Discover_Click" />
                    <TextBlock x:Name="OrganisationName" Text="Enter your organisation's server address." Foreground="#E1E8E3" TextWrapping="Wrap" FontSize="13" LineHeight="19" Margin="0,16,0,0" />
                    <Button x:Name="JoinButton" Content="Request to join" Height="42" Margin="0,15,0,0" Background="#FFFEFA" Foreground="#183236" BorderThickness="0" FontWeight="Bold" IsEnabled="False" Click="Join_Click" />
                    <Border BorderBrush="#456064" BorderThickness="1" Background="#203D41" Padding="11" Margin="0,16,0,0">
                        <TextBlock Text="To trust your organisation's server, drop its SafeNotify-LAN.cer file here." Foreground="#E1E8E3" TextWrapping="Wrap" FontSize="12" LineHeight="17" />
                    </Border>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="#456064" Margin="0,0,0,12" />
                    <TextBlock Text="Only approved devices receive alerts." Foreground="#C4D2CC" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="38,32,38,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,2,0,25">
                <TextBlock Text="SAFE NOTIFY / WINDOWS CLIENT" Foreground="#586965" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Text="Alerts for this device" Foreground="#202C2C" FontSize="30" FontFamily="Georgia" FontWeight="Bold" Margin="0,8,0,0" />
                <TextBlock x:Name="StatusMessage" Text="Enter your organisation's server address, then find the organisation." Foreground="#4F5D58" FontSize="14" TextWrapping="Wrap" LineHeight="21" Margin="0,9,0,0" />
            </StackPanel>
            <Border Grid.Row="1" Background="#FFFEFA" BorderBrush="#D6D7CE" BorderThickness="1" Padding="26">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#087579" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,12,0">
                        <TextBlock Text="When an alert arrives" Foreground="#202C2C" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Text="Approved alerts open in a window above your other apps and appear on every display. Read the instructions, then acknowledge the alert to close it." Foreground="#4F5D58" FontSize="15" TextWrapping="Wrap" LineHeight="23" Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Grid.Row="2" Text="SafeNotify supports your organisation's safety procedures. It does not replace emergency services." Foreground="#586965" FontSize="11" TextWrapping="Wrap" Margin="0,17,0,0" />
        </Grid>
    </Grid>
</Window>
