<Window x:Class="SafeNotify.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafeNotify" Height="680" Width="980" MinHeight="580" MinWidth="720" WindowStartupLocation="CenterScreen" Background="#F4F7FB">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#F3F7FB" Padding="26">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                        <Border Width="42" Height="42" CornerRadius="12" Background="#D9EDFF"><TextBlock Text="S" Foreground="#092C52" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <StackPanel Margin="11,2,0,0"><TextBlock Text="SafeNotify" FontSize="20" FontWeight="Bold" Foreground="#092C52"/><TextBlock Text="LOCAL. SECURE. RELIABLE." FontSize="9" Foreground="#526A80" Margin="0,4,0,0"/></StackPanel>
                    </StackPanel>
                    <TextBlock Text="YOUR CONNECTION" Foreground="#526A80" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Border Background="#E5EEF7" CornerRadius="9" Padding="12" Margin="0,0,0,21">
                        <StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="#E6A13A" Margin="0,4,9,0"/><TextBlock x:Name="ConnectionStatus" Text="Not connected" Foreground="#152843" FontSize="12"/></StackPanel>
                    </Border>
                    <TextBlock Text="SERVER ADDRESS" Foreground="#526A80" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBox x:Name="ServerAddress" Height="39" Padding="10,8" Background="White" Foreground="#152843" BorderBrush="#D4E0EB" CaretBrush="#152843" Text="http://127.0.0.1:5080"/>
                    <Button x:Name="DiscoverButton" Content="Find organisation" Height="39" Margin="0,10,0,0" Background="#D9EDFF" Foreground="#092C52" BorderThickness="0" FontWeight="Bold" Click="Discover_Click"/>
                    <TextBlock x:Name="OrganisationName" Text="Enter your organisation's server address." Foreground="#324C68" TextWrapping="Wrap" FontSize="12" Margin="0,16,0,0"/>
                    <Button x:Name="JoinButton" Content="Request to join" Height="40" Margin="0,17,0,0" Background="#FFFFFF" Foreground="#145B95" BorderThickness="0" FontWeight="Bold" IsEnabled="False" Click="Join_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="#DCE6F0" Margin="0,0,0,13"/>
                    <TextBlock Text="Only approved devices receive protected alerts." Foreground="#526A80" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,8,0,23">
                <TextBlock Text="ORGANISATION ALERTS" Foreground="#7790A7" FontSize="10" FontWeight="Bold"/>
                <TextBlock Text="Stay informed" Foreground="#142C47" FontSize="27" FontWeight="Bold" Margin="0,6,0,0"/>
                <TextBlock x:Name="StatusMessage" Text="Find your organisation system on the local network or enter its server address." Foreground="#71839A" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AlertList"/></ScrollViewer>
            <TextBlock Grid.Row="2" Text="SafeNotify alerts support your organisation's existing safety procedures." Foreground="#8797A7" FontSize="10" Margin="0,14,0,0"/>
        </Grid>
    </Grid>
</Window>
