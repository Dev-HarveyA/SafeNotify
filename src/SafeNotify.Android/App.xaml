<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafeNotify.Android.App">
    <Application.Resources>
        <Color x:Key="Ink">#183D40</Color>
        <Color x:Key="Teal">#0C8183</Color>
        <Color x:Key="Paper">#F4F2EC</Color>
        <Color x:Key="Muted">#637477</Color>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Teal}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="18,13" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
    </Application.Resources>
</Application>
